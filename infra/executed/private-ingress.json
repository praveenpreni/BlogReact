{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "Ingress",
  "metadata": {
    "name": "blogapp",
    "namespace": "blogapp",
    "annotations": {
      "alb.ingress.kubernetes.io/scheme": "internal",
      "alb.ingress.kubernetes.io/target-type": "ip",
      "alb.ingress.kubernetes.io/listen-ports": "[{\"HTTP\":80}]",
      "alb.ingress.kubernetes.io/healthcheck-path": "/healthz",
      "alb.ingress.kubernetes.io/security-groups": "sg-08d1ea891204b2308",
      "alb.ingress.kubernetes.io/manage-backend-security-group-rules": "true",
      "alb.ingress.kubernetes.io/load-balancer-name": "blogapp-private-alb",
      "alb.ingress.kubernetes.io/tags": "Project=BlogApp",
      "alb.ingress.kubernetes.io/target-group-attributes": "deregistration_delay.timeout_seconds=20",
      "alb.ingress.kubernetes.io/healthcheck-interval-seconds": "10",
      "alb.ingress.kubernetes.io/healthy-threshold-count": "2",
      "alb.ingress.kubernetes.io/unhealthy-threshold-count": "2"
    }
  },
  "spec": {
    "ingressClassName": "alb",
    "rules": [
      {
        "http": {
          "paths": [
            {
              "path": "/",
              "pathType": "Prefix",
              "backend": {
                "service": {
                  "name": "frontend-service",
                  "port": {
                    "number": 8080
                  }
                }
              }
            }
          ]
        }
      }
    ]
  }
}
