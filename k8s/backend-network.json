{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "backend-ingress",
    "namespace": "blogapp"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app": "backend"
      }
    },
    "policyTypes": [
      "Ingress"
    ],
    "ingress": [
      {
        "from": [
          {
            "podSelector": {
              "matchLabels": {
                "app": "frontend"
              }
            }
          },
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "monitoring"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 5000
          }
        ]
      }
    ]
  }
}
